#pragma once

#include <nvcxx/cuda/detail/config>
#include <nvcxx/cuda/std/type_traits>

namespace nvcxx::std {

template <class To, class From>
__device__ constexpr To bit_cast(From const& x)
{
  return __builtin_bit_cast(To, x);
}

namespace detail {

template <class T>
concept bit_unsigned = is_same_v<T, unsigned char> || is_same_v<T, unsigned short> ||
                       is_same_v<T, unsigned int> || is_same_v<T, unsigned long> ||
                       is_same_v<T, unsigned long long> || is_same_v<T, unsigned __int128>;

}  // namespace detail

template <detail::bit_unsigned T>
constexpr int countl_zero(T x)
{
  constexpr int width = sizeof(T) * 8;
  if (x == 0) { return width; }
  if (!__builtin_is_constant_evaluated()) {
    if constexpr (sizeof(T) <= 4) {
      return __clz(static_cast<unsigned int>(x)) - (32 - width);
    } else if constexpr (sizeof(T) <= 8) {
      return __clzll(static_cast<unsigned long long>(x));
    } else {
      auto high = static_cast<unsigned long long>(x >> 64);
      return high ? __clzll(high) : 64 + __clzll(static_cast<unsigned long long>(x));
    }
  }
  int count = 0;
  T mask    = T(1) << (width - 1);
  while ((x & mask) == 0) {
    ++count;
    mask >>= 1;
  }
  return count;
}

template <detail::bit_unsigned T>
constexpr int countr_zero(T x)
{
  if (x == 0) { return sizeof(T) * 8; }
  if (!__builtin_is_constant_evaluated()) {
    if constexpr (sizeof(T) <= 4) {
      return __ffs(static_cast<unsigned int>(x)) - 1;
    } else if constexpr (sizeof(T) <= 8) {
      return __ffsll(static_cast<unsigned long long>(x)) - 1;
    } else {
      auto low = static_cast<unsigned long long>(x);
      return low ? __ffsll(low) - 1 : 64 + __ffsll(static_cast<unsigned long long>(x >> 64)) - 1;
    }
  }
  int count = 0;
  while ((x & T{1}) == 0) {
    ++count;
    x >>= 1;
  }
  return count;
}

template <detail::bit_unsigned T>
constexpr int popcount(T x)
{
  if (!__builtin_is_constant_evaluated()) {
    if constexpr (sizeof(T) <= 4) {
      return __popc(static_cast<unsigned int>(x));
    } else if constexpr (sizeof(T) <= 8) {
      return __popcll(static_cast<unsigned long long>(x));
    } else {
      return __popcll(static_cast<unsigned long long>(x)) +
             __popcll(static_cast<unsigned long long>(x >> 64));
    }
  }
  int count = 0;
  while (x != 0) {
    ++count;
    x &= x - 1;
  }
  return count;
}

template <detail::bit_unsigned T>
constexpr int countl_one(T x)
{
  return countl_zero(static_cast<T>(~x));
}

template <detail::bit_unsigned T>
constexpr int countr_one(T x)
{
  return countr_zero(static_cast<T>(~x));
}

template <detail::bit_unsigned T>
constexpr int bit_width(T x)
{
  return int(sizeof(T) * 8) - countl_zero(x);
}

template <detail::bit_unsigned T>
constexpr T bit_floor(T x)
{
  return x == 0 ? T(0) : static_cast<T>(T(1) << (bit_width(x) - 1));
}

template <detail::bit_unsigned T>
constexpr T bit_ceil(T x)
{
  if (x <= 1) { return T(1); }
  int shift = bit_width(static_cast<T>(x - 1));
  if (shift == int(sizeof(T) * 8)) { __builtin_unreachable(); }
  return static_cast<T>(T(1) << shift);
}

template <detail::bit_unsigned T>
constexpr T rotl(T x, int shift)
{
  constexpr int width = sizeof(T) * 8;
  int rotation        = shift % width;
  if (rotation < 0) { rotation += width; }
  if (rotation == 0) { return x; }
  return static_cast<T>((x << rotation) | (x >> (width - rotation)));
}

template <detail::bit_unsigned T>
constexpr T rotr(T x, int shift)
{
  constexpr int width = sizeof(T) * 8;
  int rotation        = shift % width;
  if (rotation < 0) { rotation += width; }
  if (rotation == 0) { return x; }
  return static_cast<T>((x >> rotation) | (x << (width - rotation)));
}

template <class T>
  requires is_integral_v<T>
constexpr T byteswap(T x)
{
  if constexpr (sizeof(T) == 1) {
    return x;
  } else {
    using U = __make_unsigned(T);
    U value = __builtin_bit_cast(U, x);
    if (!__builtin_is_constant_evaluated()) {
      if constexpr (sizeof(T) == 2) {
        return __builtin_bit_cast(
          T, static_cast<U>(__byte_perm(static_cast<unsigned int>(value), 0, 0x4401)));
      } else if constexpr (sizeof(T) == 4) {
        return __builtin_bit_cast(
          T, static_cast<U>(__byte_perm(static_cast<unsigned int>(value), 0, 0x0123)));
      } else if constexpr (sizeof(T) == 8) {
        U low  = __byte_perm(static_cast<unsigned int>(value), 0, 0x0123);
        U high = __byte_perm(static_cast<unsigned int>(value >> 32), 0, 0x0123);
        return __builtin_bit_cast(T, static_cast<U>((low << 32) | high));
      } else {
        U low  = byteswap(static_cast<unsigned long long>(value));
        U high = byteswap(static_cast<unsigned long long>(value >> 64));
        return __builtin_bit_cast(T, static_cast<U>((low << 64) | high));
      }
    }
    U result = 0;
    for (int i = 0; i < int(sizeof(T)); ++i) {
      result = static_cast<U>((result << 8) | (value & U(255)));
      value >>= 8;
    }
    return __builtin_bit_cast(T, result);
  }
}

}  // namespace nvcxx::std
