#pragma once

#include <nvcxx/cuda/detail/config>
#include <nvcxx/cuda/detail/integer_bounds>
#include <nvcxx/cuda/std/type_traits>

namespace nvcxx {

// Implementation helpers

namespace detail {

template <class T>
concept overflow_integer =
  std::is_same_v<T, signed char> || std::is_same_v<T, unsigned char> || std::is_same_v<T, short> ||
  std::is_same_v<T, unsigned short> || std::is_same_v<T, int> || std::is_same_v<T, unsigned int> ||
  std::is_same_v<T, long> || std::is_same_v<T, unsigned long> || std::is_same_v<T, long long> ||
  std::is_same_v<T, unsigned long long> || std::is_same_v<T, __int128> ||
  std::is_same_v<T, unsigned __int128>;

}  // namespace detail

// Result types

template <class T>
struct overflow_result {
  T value;
  bool overflow;

  constexpr explicit operator bool() const { return overflow; }
};

// Conversions

template <detail::overflow_integer To, detail::overflow_integer From>
constexpr overflow_result<To> overflow_cast(From const& value)
{
  bool overflow;
  if constexpr (std::is_signed_v<From>) {
    if (value < 0) {
      if constexpr (std::is_signed_v<To>) {
        overflow = static_cast<__int128>(value) <
                   static_cast<__int128>(detail::integer_bounds<To>::lowest());
      } else {
        overflow = true;
      }
    } else {
      overflow = static_cast<unsigned __int128>(value) >
                 static_cast<unsigned __int128>(detail::integer_bounds<To>::max());
    }
  } else {
    overflow = static_cast<unsigned __int128>(value) >
               static_cast<unsigned __int128>(detail::integer_bounds<To>::max());
  }
  return {static_cast<To>(value), overflow};
}

// Binary arithmetic

template <detail::overflow_integer T>
constexpr overflow_result<T> add_overflow(T a, T b)
{
  T r = static_cast<T>(static_cast<unsigned __int128>(a) + static_cast<unsigned __int128>(b));
  return {r,
          (b > 0 && a > detail::integer_bounds<T>::max() - b) ||
            (b < 0 && a < detail::integer_bounds<T>::lowest() - b)};
}

template <detail::overflow_integer T>
constexpr bool add_overflow(T& result, T a, T b)
{
  auto r = add_overflow<T>(a, b);
  result = r.value;
  return r.overflow;
}

template <detail::overflow_integer T>
constexpr overflow_result<T> sub_overflow(T a, T b)
{
  if constexpr (std::is_signed_v<T>) {
    // Keep the wrapped minimum explicit; NVRTC 12.9 miscompiles its negation path.
    if (a == 0 && b == detail::integer_bounds<T>::lowest()) { return {b, true}; }
  }
  T r = static_cast<T>(static_cast<unsigned __int128>(a) - static_cast<unsigned __int128>(b));
  return {r,
          (b < 0 && a > detail::integer_bounds<T>::max() + b) ||
            (b > 0 && a < detail::integer_bounds<T>::lowest() + b)};
}

template <detail::overflow_integer T>
constexpr bool sub_overflow(T& result, T a, T b)
{
  auto r = sub_overflow<T>(a, b);
  result = r.value;
  return r.overflow;
}

template <detail::overflow_integer T>
constexpr overflow_result<T> mul_overflow(T a, T b)
{
  if (a == 0 || b == 0) { return {0, false}; }
  T r = static_cast<T>(static_cast<unsigned __int128>(a) * static_cast<unsigned __int128>(b));
  return {r,
          (a > 0 ? (b > 0 ? a > detail::integer_bounds<T>::max() / b
                          : b < detail::integer_bounds<T>::lowest() / a)
                 : (b > 0 ? a < detail::integer_bounds<T>::lowest() / b
                          : a < detail::integer_bounds<T>::max() / b))};
}

template <detail::overflow_integer T>
constexpr bool mul_overflow(T& result, T a, T b)
{
  auto r = mul_overflow<T>(a, b);
  result = r.value;
  return r.overflow;
}

template <detail::overflow_integer T>
constexpr overflow_result<T> div_overflow(T a, T b)
{
  bool bad =
    b == 0 || (std::is_signed_v<T> && a == detail::integer_bounds<T>::lowest() && b == T(-1));
  return {bad ? T(0) : T(a / b), bad};
}

template <detail::overflow_integer T>
constexpr bool div_overflow(T& result, T a, T b)
{
  auto r = div_overflow<T>(a, b);
  result = r.value;
  return r.overflow;
}

template <detail::overflow_integer T>
constexpr overflow_result<T> mod_overflow(T a, T b)
{
  if (b == 0) { return {0, true}; }
  if constexpr (std::is_signed_v<T>) {
    if (b == T(-1)) { return {0, false}; }
  }
  return {T(a % b), false};
}

// Unary arithmetic

template <detail::overflow_integer T>
constexpr overflow_result<T> neg_overflow(T a)
{
  return sub_overflow(T(0), a);
}

template <detail::overflow_integer T>
constexpr overflow_result<T> abs_overflow(T a)
{
  return a < 0 ? neg_overflow(a) : overflow_result<T>{a, false};
}

}  // namespace nvcxx
