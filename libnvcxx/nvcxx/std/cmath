namespace detail {

template <class T>
concept math_arithmetic = is_integral_v<T> || is_same_v<T, float> || is_same_v<T, double>;

template <class T>
using math_promote_t = conditional_t<is_integral_v<T>, double, T>;

template <class... T>
using math_common_t = common_type_t<math_promote_t<T>...>;

}  // namespace detail

using ::atan2;

template <detail::math_arithmetic T, detail::math_arithmetic U>
__device__ inline detail::math_common_t<T, U> atan2(T x, U y)
{
  using R = detail::math_common_t<T, U>;
  return nvcxx::std::atan2(static_cast<R>(x), static_cast<R>(y));
}

using ::hypot;

template <detail::math_arithmetic T, detail::math_arithmetic U>
__device__ inline detail::math_common_t<T, U> hypot(T x, U y)
{
  using R = detail::math_common_t<T, U>;
  return nvcxx::std::hypot(static_cast<R>(x), static_cast<R>(y));
}

using ::fma;

template <detail::math_arithmetic T, detail::math_arithmetic U, detail::math_arithmetic V>
__device__ inline detail::math_common_t<T, U, V> fma(T x, U y, V z)
{
  using R = detail::math_common_t<T, U, V>;
  return nvcxx::std::fma(static_cast<R>(x), static_cast<R>(y), static_cast<R>(z));
}

template <detail::math_arithmetic T, detail::math_arithmetic U, detail::math_arithmetic V>
__device__ inline detail::math_common_t<T, U, V> hypot(T x, U y, V z)
{
  using R = detail::math_common_t<T, U, V>;
  if constexpr (is_same_v<R, float>) {
    return ::norm3df(static_cast<R>(x), static_cast<R>(y), static_cast<R>(z));
  } else {
    return ::norm3d(static_cast<R>(x), static_cast<R>(y), static_cast<R>(z));
  }
}

